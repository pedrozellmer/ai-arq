<div style="width:1123px;height:794px;background:#fdfcfa;position:relative;padding:52px 56px 40px;font-family:'Space Grotesk',sans-serif;overflow:hidden;border:1px solid #ececec">
  <div style="position:absolute;top:0;left:0;width:100%;height:6px;background:var(--accent,#4F46E5)"></div>
  <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px">
    <div style="font:700 12px/1 'Space Grotesk';letter-spacing:.2em;color:var(--accent,#4F46E5)">GANTT · CRONOGRAMA FÍSICO</div>
    <div style="font:500 11px/1 'Space Grotesk';letter-spacing:.14em;color:#adadad">02 / {{ n_paginas }}</div>
  </div>
  <div style="font:700 42px/1.02 'Space Grotesk';color:#141414;letter-spacing:-0.03em">Cronograma físico das disciplinas</div>

  <div style="margin-top:22px;background:color-mix(in srgb, var(--accent,#4F46E5) 7%, #ffffff);border-radius:22px;padding:22px 30px 14px">
    <div style="margin:0 0 6px 224px;position:relative;height:18px">
      {% for a in axis %}<div style="position:absolute;left:{{ a.pct }}%;transform:translateX(-50%);font:600 10.5px 'Space Grotesk';letter-spacing:.06em;color:#9a9a9a">{{ a.label }}</div>
      {% endfor %}
    </div>
    <div style="display:flex">
      <div style="width:224px;flex:none">
        {% for f in fases %}<div style="height:40px;line-height:40px;text-align:right;padding-right:18px;font:600 12.5px 'Space Grotesk';color:#2a2a2a">{{ f.label }}</div>
        {% endfor %}
      </div>
      <div style="flex:1;position:relative">
        {% for a in axis %}<div style="position:absolute;left:{{ a.pct }}%;top:0;bottom:0;width:1px;background:rgba(20,20,20,.06)"></div>
        {% endfor %}

        {% for f in fases %}<div style="position:relative;height:40px"><div style="position:absolute;top:5px;left:{{ f.left_pct }}%;width:{{ f.width_pct }}%;height:30px;border-radius:9px;background:{{ f.cor }};color:{{ f.txt }};overflow:hidden;display:flex;align-items:center;justify-content:flex-end;padding:0 12px;font:700 13px 'Space Grotesk'">{% if f.pct_exec > 0 %}<div style="position:absolute;top:0;left:0;bottom:0;width:{{ f.pct_exec }}%;background:rgba(15,17,21,.30)"></div>{% endif %}<span style="position:relative">{{ f.dur_dias }}d</span></div></div>
        {% endfor %}
        {% if hoje_pct is not none %}<div style="position:absolute;top:0;bottom:0;left:{{ hoje_pct }}%;width:0;border-left:2px dashed var(--accent,#4F46E5)"></div>{% endif %}
      </div>
    </div>
  </div>

  <div style="position:absolute;left:56px;right:56px;bottom:34px;display:flex;align-items:center;justify-content:space-between">
    <div style="white-space:nowrap">
      {% for lg in legenda %}<span style="display:inline-block;margin-right:20px"><span style="display:inline-block;width:16px;height:16px;border-radius:5px;vertical-align:middle;margin-right:8px;background:{{ lg.cor }}"></span><span style="vertical-align:middle;font:600 12px 'Space Grotesk';color:#5a5a5a">{{ lg.label }}</span></span>{% endfor %}
    </div>
    <div style="font:500 11.5px 'Space Grotesk';color:#adadad">powered by AI.arq · ai.arq.br</div>
  </div>
</div>
