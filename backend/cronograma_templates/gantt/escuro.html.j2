<div style="width:1123px;height:794px;background:radial-gradient(1100px 460px at 84% -10%, color-mix(in srgb, var(--accent,#4F46E5) 26%, transparent), transparent 60%), #0f1115;position:relative;padding:56px 64px 40px;font-family:'Space Grotesk',sans-serif;overflow:hidden">
  <div style="position:absolute;top:0;left:0;width:100%;height:5px;background:var(--accent,#4F46E5)"></div>
  <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px">
    <div style="font:600 12px/1 'Space Grotesk';letter-spacing:.22em;color:color-mix(in srgb, var(--accent,#4F46E5) 55%, #ffffff)">GANTT · CRONOGRAMA FÍSICO</div>
    <div style="font:400 11px/1 'Space Grotesk';letter-spacing:.14em;color:#5b6472">02 / 05</div>
  </div>
  <div style="font:600 40px/1.05 'Space Grotesk';color:#f5f6f8;letter-spacing:-0.02em">Cronograma físico das disciplinas</div>
  <div style="font:400 13.5px/1.5 'Space Grotesk';color:#8a93a3;margin-top:9px;max-width:720px">{{ r.n_fases }} disciplinas ao longo de {{ r.duracao_dias }} dias. Largura da barra = duração prevista.</div>

  <!-- axis -->
  <div style="margin:30px 0 0 236px;position:relative;height:20px;border-bottom:1px solid #23283a">
    {% for a in axis %}<div style="position:absolute;left:{{ a.pct }}%;transform:translateX(-50%);font:500 10.5px 'Space Grotesk';letter-spacing:.06em;color:#5b6472">{{ a.label }}</div>
    {% endfor %}
  </div>

  <div style="display:flex;margin-top:2px">
    <div style="width:236px;flex:none;padding-top:8px">
      {% for f in fases %}<div style="height:40px;line-height:40px;text-align:right;padding-right:20px;font:500 12.5px 'Space Grotesk';color:#c3cad6">{{ f.label }}</div>
      {% endfor %}
    </div>
    <div style="flex:1;position:relative;padding-top:8px">
      {% for a in axis %}<div style="position:absolute;left:{{ a.pct }}%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.06)"></div>
      {% endfor %}

      {% for f in fases %}<div style="position:relative;height:40px"><div style="position:absolute;top:13px;left:{{ f.left_pct }}%;width:{{ f.width_pct }}%;height:14px;border-radius:7px;background:{{ f.cor }};box-shadow:0 0 15px -2px {{ f.cor_glow }};overflow:hidden">{% if f.pct_exec > 0 %}<div style="position:absolute;top:0;left:0;bottom:0;width:{{ f.pct_exec }}%;background:rgba(10,11,15,.42)"></div>{% endif %}</div><div style="position:absolute;top:11px;left:{{ f.label_pct }}%;margin-left:10px;font:600 10.5px 'Space Grotesk';color:#aab2c0">{{ f.dur_dias }}d</div></div>
      {% endfor %}
      {% if hoje_pct is not none %}<div style="position:absolute;top:0;bottom:0;left:{{ hoje_pct }}%;width:0;border-left:2px dashed color-mix(in srgb, var(--accent,#4F46E5) 70%, #ffffff)"></div>{% endif %}
    </div>
  </div>

  <div style="position:absolute;left:64px;right:64px;bottom:34px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid #23283a;padding-top:14px">
    <div style="white-space:nowrap">
      <span style="display:inline-block;margin-right:22px"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;vertical-align:middle;margin-right:7px;background:var(--accent,#4F46E5)"></span><span style="vertical-align:middle;font:500 11.5px 'Space Grotesk';color:#8a93a3">Estrutura</span></span>
      <span style="display:inline-block;margin-right:22px"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;vertical-align:middle;margin-right:7px;background:color-mix(in srgb, var(--accent,#4F46E5) 72%, #14141b)"></span><span style="vertical-align:middle;font:500 11.5px 'Space Grotesk';color:#8a93a3">Instalações</span></span>
      <span style="display:inline-block;margin-right:22px"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;vertical-align:middle;margin-right:7px;background:color-mix(in srgb, var(--accent,#4F46E5) 46%, #6b7280)"></span><span style="vertical-align:middle;font:500 11.5px 'Space Grotesk';color:#8a93a3">Acabamentos</span></span>
    </div>
    <div style="font:400 11px 'Space Grotesk';letter-spacing:.1em;color:#5b6472">powered by AI.arq · ai.arq.br</div>
  </div>
</div>
