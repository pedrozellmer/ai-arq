<div style="width:1123px;height:794px;background-color:var(--p-bg,#faf9f7);background-image:var(--p-grid,none);background-size:34px 34px;position:relative;padding:56px 64px 40px;font-family:var(--p-fb,'Inter'),sans-serif;overflow:hidden">
  <div style="position:absolute;top:0;left:0;width:100%;height:5px;background:var(--accent,#4F46E5)"></div>
  <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px">
    <div style="font:700 12px/1 var(--p-fl,'Inter');letter-spacing:.22em;color:var(--p-eyebrow,var(--accent,#4F46E5))">CAMINHO CRÍTICO</div>
    <div style="font:400 11px/1 var(--p-fl,'Inter');letter-spacing:.14em;color:var(--p-muted,#94A3B8)">04 / 05</div>
  </div>
  <div style="font:var(--p-title-weight,600) 40px/1.05 var(--p-ft,'Inter');color:var(--p-title,#0F172A);letter-spacing:-0.015em">As cinco fases mais longas</div>
  <div style="font:400 13.5px/1.5 var(--p-fb,'Inter');color:var(--p-muted,#64748B);margin-top:9px;max-width:820px">Atraso em qualquer uma delas empurra a obra inteira. É aqui que fornecedor, equipe e gestão de risco merecem prioridade.</div>

  <div style="margin-top:34px;display:flex;flex-direction:column;gap:14px">
    {% for c in caminho %}
    <div style="display:flex;align-items:center;gap:24px;background:var(--p-card,#fff);border:1px solid var(--p-border,#E2E8F0);border-radius:var(--p-radius,14px);padding:20px 26px">
      <div style="font:var(--p-title-weight,700) 34px var(--p-ft,'Inter');color:var(--accent,#4F46E5);width:40px;flex:none;line-height:1">{{ c.rank }}</div>
      <div style="width:280px;flex:none;font:600 18px var(--p-fb,'Inter');color:var(--p-title,#0F172A)">{{ c.label }}</div>
      <div style="flex:1;height:10px;border-radius:6px;background:color-mix(in srgb, var(--accent,#4F46E5) 14%, transparent);position:relative"><div style="position:absolute;left:0;top:0;height:100%;width:{{ c.width_pct }}%;border-radius:6px;background:{% if c.cat == 'estrutura' %}var(--accent,#4F46E5){% elif c.cat == 'instalacoes' %}color-mix(in srgb, var(--accent,#4F46E5) 72%, #14141b){% else %}color-mix(in srgb, var(--accent,#4F46E5) 46%, #6b7280){% endif %}"></div></div>
      <div style="width:96px;flex:none;text-align:right;font:700 17px var(--p-fb,'Inter');color:var(--p-title,#0F172A)">{{ c.dur_dias }} dias</div>
    </div>
    {% endfor %}
  </div>

  <div style="position:absolute;left:64px;right:64px;bottom:34px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--p-border,#E2E8F0);padding-top:14px">
    <div style="font:400 12px var(--p-fb,'Inter');color:var(--p-muted,#94A3B8)">Barra proporcional à duração · maior fase = {% if caminho %}{{ caminho|map(attribute='dur_dias')|max }}{% else %}0{% endif %} dias</div>
    <div style="font:400 11px var(--p-fl,'Inter');letter-spacing:.1em;color:var(--p-muted,#94A3B8)">AI.arq · ai.arq.br</div>
  </div>
</div>
