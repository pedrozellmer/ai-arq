<div style="width:1123px;height:794px;background-color:var(--p-bg,#faf9f7);background-image:var(--p-grid,none);background-size:34px 34px;position:relative;padding:56px 64px 40px;font-family:var(--p-fb,'Inter'),sans-serif;overflow:hidden">
  <div style="position:absolute;top:0;left:0;width:100%;height:5px;background:var(--accent,#4F46E5)"></div>
  <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px">
    <div style="font:700 12px/1 var(--p-fl,'Inter');letter-spacing:.22em;color:var(--p-eyebrow,var(--accent,#4F46E5))">CURVA S · AVANÇO PREVISTO</div>
    <div style="font:400 11px/1 var(--p-fl,'Inter');letter-spacing:.14em;color:var(--p-muted,#94A3B8)">03 / 05</div>
  </div>
  <div style="font:var(--p-title-weight,600) 40px/1.05 var(--p-ft,'Inter');color:var(--p-title,#0F172A);letter-spacing:-0.015em">Como a obra progride no tempo</div>
  <div style="font:400 13.5px/1.5 var(--p-fb,'Inter');color:var(--p-muted,#64748B);margin-top:9px;max-width:760px">Modelo sigmoidal (k=10): arranque suave no canteiro, pico de execução no meio, finalização gradual nos acabamentos.</div>

  <svg viewBox="0 0 1000 400" style="width:100%;height:452px;display:block;margin-top:18px">
    <line x1="70" y1="20" x2="970" y2="20" style="stroke:var(--p-border,#E2E8F0);stroke-width:1"></line>
    <line x1="70" y1="88" x2="970" y2="88" style="stroke:var(--p-border,#E2E8F0);stroke-width:1"></line>
    <line x1="70" y1="156" x2="970" y2="156" style="stroke:var(--p-border,#E2E8F0);stroke-width:1"></line>
    <line x1="70" y1="224" x2="970" y2="224" style="stroke:var(--p-border,#E2E8F0);stroke-width:1"></line>
    <line x1="70" y1="292" x2="970" y2="292" style="stroke:var(--p-border,#E2E8F0);stroke-width:1"></line>
    <line x1="70" y1="360" x2="970" y2="360" style="stroke:var(--p-border,#E2E8F0);stroke-width:1.5"></line>
    <text x="56" y="24" text-anchor="end" style="fill:var(--p-muted,#94A3B8);font:500 12px var(--p-fl,'Inter')">100</text>
    <text x="56" y="92" text-anchor="end" style="fill:var(--p-muted,#94A3B8);font:500 12px var(--p-fl,'Inter')">80</text>
    <text x="56" y="160" text-anchor="end" style="fill:var(--p-muted,#94A3B8);font:500 12px var(--p-fl,'Inter')">60</text>
    <text x="56" y="228" text-anchor="end" style="fill:var(--p-muted,#94A3B8);font:500 12px var(--p-fl,'Inter')">40</text>
    <text x="56" y="296" text-anchor="end" style="fill:var(--p-muted,#94A3B8);font:500 12px var(--p-fl,'Inter')">20</text>
    <text x="56" y="364" text-anchor="end" style="fill:var(--p-muted,#94A3B8);font:500 12px var(--p-fl,'Inter')">0</text>

    <path d="{{ curva.area_d }}" style="fill:var(--accent,#4F46E5);opacity:0.12"></path>
    <path d="{{ curva.line_d }}" style="fill:none;stroke:var(--accent,#4F46E5);stroke-width:3.5;stroke-linejoin:round;stroke-linecap:round"></path>
    {% if curva.real_d %}
    <path d="{{ curva.real_d }}" style="fill:none;stroke:var(--p-title,#0F172A);stroke-width:3;stroke-dasharray:8 7;stroke-linejoin:round;stroke-linecap:round"></path>
    {% endif %}

    {% for m in curva.markers %}
    {#- perto da borda direita, joga o rótulo pra ESQUERDA do ponto (evita corte no viewBox) #}
    {%- set _tx = (m.cx - 13) if m.cx > 880 else (m.cx + 13) %}
    {%- set _ta = 'end' if m.cx > 880 else 'start' %}
    {%- if m.filled %}
    <circle cx="{{ m.cx }}" cy="{{ m.cy }}" r="6" style="fill:var(--accent,#4F46E5);stroke:var(--p-bg,#fff);stroke-width:3"></circle>
    <text x="{{ _tx }}" y="{{ m.cy + 14 }}" text-anchor="{{ _ta }}" style="fill:var(--p-body,#334155);font:700 13px var(--p-fb,'Inter')">{{ m.pct }}%</text>
    {%- else %}
    <circle cx="{{ m.cx }}" cy="{{ m.cy }}" r="6" style="fill:var(--p-bg,#fff);stroke:var(--accent,#4F46E5);stroke-width:3"></circle>
    <text x="{{ _tx }}" y="{{ m.cy - 3 }}" text-anchor="{{ _ta }}" style="fill:var(--p-body,#334155);font:700 13px var(--p-fb,'Inter')">{{ m.pct }}%</text>
    {%- endif %}
    {% endfor %}

    {% for x in curva.xlabels %}
    <text x="{{ x.x }}" y="382" text-anchor="middle" style="fill:var(--p-muted,#94A3B8);font:500 11px var(--p-fl,'Inter')">{{ x.label }}</text>
    {% endfor %}
  </svg>

  <div style="position:absolute;left:64px;right:64px;bottom:34px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--p-border,#E2E8F0);padding-top:14px">
    <div style="font:400 12px var(--p-fb,'Inter');color:var(--p-body,#475569);max-width:640px">{% if curva.real_d %}<span style="display:inline-block;width:18px;height:0;border-top:3px solid var(--accent,#4F46E5);vertical-align:middle;margin-right:6px;border-radius:2px"></span><span style="vertical-align:middle;margin-right:16px">Previsto</span><span style="display:inline-block;width:18px;height:0;border-top:3px dashed var(--p-title,#0F172A);vertical-align:middle;margin-right:6px"></span><span style="vertical-align:middle;margin-right:16px">Realizado</span>{% endif %}Marcos 25 / 50 / 75 / 100% para medição mensal — <span style="color:var(--p-muted,#94A3B8)">Lei 14.133/2021, Art. 117.</span></div>
    <div style="font:400 11px var(--p-fl,'Inter');letter-spacing:.1em;color:var(--p-muted,#94A3B8)">AI.arq · ai.arq.br</div>
  </div>
</div>
